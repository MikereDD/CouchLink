<Window x:Class="CouchLink.Host.Wpf.Views.AudioOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CouchLink Audio Output"
        Icon="/Assets/couchlink.ico"
        Width="520" Height="720" MinWidth="460" MinHeight="560"
        Background="#05080B"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#05080B" Offset="0"/>
            <GradientStop Color="#0B1117" Offset="0.52"/>
            <GradientStop Color="#070A0E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RaisedCardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#151D25" Offset="0"/>
            <GradientStop Color="#0D1319" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActiveCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#352014" Offset="0"/>
            <GradientStop Color="#1B120D" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBrush" Color="#0A0F14"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#35414C"/>
        <SolidColorBrush x:Key="OrangeDimBrush" Color="#8D4B19"/>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#1A222B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#2A190E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CouchButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource RaisedCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#17202A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A190E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource CouchButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="#17100B"/>
        </Style>

        <Style x:Key="DeviceButton" TargetType="Button" BasedOn="{StaticResource CouchButton}">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="2,1"
                                Background="#46515C"
                                BorderBrush="#5C6874"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#687480"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8D4B19"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="#090D11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"
                                           MinHeight="28"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#080C10" BorderBrush="#202A33" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/couchlink.png" Width="30" Height="30" Stretch="Uniform"/>
                    <TextBlock Margin="8,0,0,0" Text="CouchLink Audio Output" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="×" FontSize="20" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14" BorderBrush="{StaticResource OrangeDimBrush}" BorderThickness="1" CornerRadius="22" Background="#080C10">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="29" FontWeight="Bold">
                        <Run Text="Audio "/><Run Text="Output" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <TextBlock x:Name="CurrentOutputText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" FontWeight="SemiBold" Text="Loading current output…"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="12" Background="{StaticResource CardBrush}" CornerRadius="14" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="HEADPHONES" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource CouchButton}" Padding="8,2" Content="EDIT" FontSize="10" Click="EditHeadphones_Click"/>
                            </Grid>
                            <Button x:Name="HeadphonesButton" Style="{StaticResource CouchButton}" Margin="0,10,0,0" Padding="10" HorizontalContentAlignment="Left" Click="Headphones_Click">
                                <StackPanel>
                                    <TextBlock x:Name="HeadphonesName" Text="Not assigned" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HeadphonesStatus" Margin="0,5,0,0" Text="CHOOSE OUTPUT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="12" Background="{StaticResource CardBrush}" CornerRadius="14" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="TV / DISPLAY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource CouchButton}" Padding="8,2" Content="EDIT" FontSize="10" Click="EditDisplay_Click"/>
                            </Grid>
                            <Button x:Name="DisplayButton" Style="{StaticResource CouchButton}" Margin="0,10,0,0" Padding="10" HorizontalContentAlignment="Left" Click="Display_Click">
                                <StackPanel>
                                    <TextBlock x:Name="DisplayName" Text="Not assigned" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DisplayStatus" Margin="0,5,0,0" Text="CHOOSE OUTPUT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Padding="10" Background="#070B0F" CornerRadius="16" BorderBrush="#25303A" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Padding="0,0,2,2">
                        <ItemsControl x:Name="DeviceList" Margin="0,0,0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DeviceButton}" Tag="{Binding Id}" Click="Device_Click"
                                            Background="{Binding CardBrush}" BorderBrush="{Binding BorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding IndicatorBrush}" Stroke="#66717C" StrokeThickness="1"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <TextBlock Text="CURRENT OUTPUT" Margin="0,3,0,0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                                           Visibility="{Binding CurrentVisibility}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="Bold" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Choose an output."/>
                    <Button Grid.Column="1" Style="{StaticResource CouchButton}" Padding="16,10" Content="CLOSE" Click="Close_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Padding="16,10" Content="REFRESH" Click="Refresh_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
