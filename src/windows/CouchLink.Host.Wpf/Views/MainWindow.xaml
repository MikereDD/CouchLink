<Window x:Class="CouchLink.Host.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CouchLink Host" Icon="/Assets/couchlink.ico"
        Width="1180" Height="760" MinWidth="980" MinHeight="650"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="7" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#090D11" BorderBrush="#25303A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/couchlink.png" Width="34" Height="34" Stretch="Uniform" />
                    <TextBlock Margin="7,0,0,0" Text="CouchLink Host" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click"
                        FontSize="16" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="□" Click="MaximizeRestore_Click"
                        FontSize="14" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="×" Click="Close_Click"
                        FontSize="20" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="30" FontWeight="SemiBold">
                        <Run Text="Couch"/><Run Text="Link" Foreground="{StaticResource AccentBrush}"/><Run Text=" Host"/>
                    </TextBlock>
                    <TextBlock Margin="0,7,0,0" Text="Your Windows PC, from the couch."
                               FontSize="15" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,12,0" Style="{StaticResource CouchButton}" Content="ABOUT" Click="About_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Border Padding="14,9" CornerRadius="14" Background="{StaticResource RaisedCardBrush}"
                            BorderBrush="#26313B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding VersionBadge}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.48*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Padding="22" Background="#080D12" BorderBrush="#26313B" BorderThickness="1" CornerRadius="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Host status" FontSize="20" FontWeight="SemiBold" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Margin="0,0,7,0" Padding="16" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="DEVELOPMENT HOST" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding HostName}" FontSize="23" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="7,0,0,0" Padding="16" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="HOST STATE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding HostState}" FontSize="18" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.62*"/></Grid.ColumnDefinitions>
                            <Border Margin="0,0,7,0" Padding="16" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="HOST LISTENER" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="{Binding ServiceStatus}" FontSize="16" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0" Text="{Binding DiscoveryStatus}" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="7,0,0,0" Padding="16" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="CLIENTS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding ConnectedClients}" FontSize="23" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="6" Padding="17" Background="{StaticResource RaisedCardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="DISCOVERY" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding DiscoveryStatus}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding DiscoveryEndpoint}" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2B3742" />
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="SESSION ENDPOINT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding SessionEndpoint}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="Pairing required" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="20" Background="#080D12" BorderBrush="#26313B" BorderThickness="1" CornerRadius="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Devices &amp; pairing" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                       Text="Pair new remotes and revoke old devices. Keyboard and mouse run over the phone Bluetooth HID, not the host." />

                            <Border Margin="0,15,0,0" Padding="15" CornerRadius="14" Background="#0A0F14"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PAIRING" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding PairingCodeDisplay}" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding PairingHelpText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                    <Button Margin="0,11,0,0" Style="{StaticResource AccentButton}" Command="{Binding PairNewDeviceCommand}" Content="PAIR NEW DEVICE" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,13,0,0" Padding="15" CornerRadius="14" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="TRUSTED DEVICES" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                        <Border Grid.Column="1" Padding="8,2" Background="#21150D" BorderBrush="#7D461E" BorderThickness="1" CornerRadius="9">
                                            <TextBlock Text="{Binding TrustedDevices}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                    <ListBox Margin="0,10,0,0" Height="154" ItemsSource="{Binding TrustedDeviceList}"
                                             SelectedItem="{Binding SelectedTrustedDevice}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Margin" Value="0,0,0,7" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="DeviceCard" Padding="12,10" Background="#0D141B"
                                                                    BorderBrush="#35414C" BorderThickness="1" CornerRadius="11">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="DeviceCard" Property="BorderBrush" Value="#667481" />
                                                                    <Setter TargetName="DeviceCard" Property="Background" Value="#121B24" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="DeviceCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                    <Setter TargetName="DeviceCard" Property="Background" Value="#21150D" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding ClientId}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding PairedAtUtc, StringFormat={}Paired: {0:g}}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="22" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource CouchButton}" Padding="10,8" Command="{Binding RevokeSelectedDeviceCommand}" Content="REVOKE SELECTED" />
                                        <Button Grid.Column="2" Style="{StaticResource DangerButton}" Padding="10,8" Command="{Binding RevokeAllDevicesCommand}" Content="REVOKE ALL" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,13,0,0" Padding="15" CornerRadius="14" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CONNECTED DEVICE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,9,0" Fill="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="{Binding ConnectedDevice}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,13,0,0" Padding="15" CornerRadius="14" Background="{StaticResource RaisedCardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="STARTUP" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <CheckBox Margin="0,11,0,0" Style="{StaticResource CouchCheckBox}" Content="Start CouchLink with Windows" IsChecked="{Binding StartWithWindows}" />
                                    <CheckBox Margin="0,10,0,0" Style="{StaticResource CouchCheckBox}" Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" />
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                               Text="The host launches, focuses, and closes apps for paired remotes on the local network." />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,13,0,0" Padding="15" CornerRadius="14" Background="#0A0F14"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LAST HOST EVENT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding LastEvent}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource SuccessBrush}" />
                    <TextBlock Text="Launcher host active" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="Host ID: " /><Run Text="{Binding HostId, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
