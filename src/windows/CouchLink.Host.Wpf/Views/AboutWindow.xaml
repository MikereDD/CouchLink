<Window x:Class="CouchLink.Host.Wpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About CouchLink Host"
        Icon="/Assets/couchlink.ico"
        Width="700"
        Height="720"
        MinWidth="620"
        MinHeight="620"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBrush}"
                BorderBrush="{StaticResource WindowPanelBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/couchlink.png"
                           Width="34"
                           Height="34"
                           Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0"
                               Text="About CouchLink Host"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource ChromeButton}"
                        Content="—"
                        Click="Minimize_Click"
                        FontSize="16"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                <Button Grid.Column="2"
                        Style="{StaticResource ChromeButton}"
                        Content="□"
                        Click="MaximizeRestore_Click"
                        FontSize="14"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                <Button Grid.Column="3"
                        Style="{StaticResource ChromeButton}"
                        Content="×"
                        Click="Close_Click"
                        FontSize="20"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="78"
                   Height="78"
                   Source="/Assets/couchlink.png"
                   Stretch="Uniform" />
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold">
                    <Run Text="Couch"/><Run Text="Link" Foreground="{StaticResource AccentBrush}"/><Run Text=" Host"/>
                </TextBlock>
                <TextBlock Margin="0,7,0,0"
                           Text="{Binding HostVersion}"
                           FontSize="15"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding BuildChannel, StringFormat={}Build channel: {0}}"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,18">
                <Border Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource WindowPanelBrush}"
                        BorderBrush="{StaticResource WindowPanelBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ABOUT"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="CouchLink turns an Android device into a secure local remote for Windows, including mouse, keyboard, launcher actions, and authorized pre-login control."
                                   TextWrapping="Wrap"
                                   FontSize="15" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding PrivacySummary}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource WindowPanelBrush}"
                        BorderBrush="{StaticResource WindowPanelBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="HOST"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding HostName}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding HostState}"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding SessionEndpoint}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="COMPONENTS"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding ServiceStatus, StringFormat={}Host listener: {0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding DiscoveryStatus, StringFormat={}Discovery: {0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ConnectedDevice, StringFormat={}Connected: {0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="Input: phone Bluetooth HID"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ProtocolVersion, StringFormat={}Protocol: {0}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>


                <Border Margin="0,16,0,0"
                        Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource WindowPanelBrush}"
                        BorderBrush="{StaticResource WindowPanelBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="APP UPDATES"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="UpdateStatusText"
                                   Margin="0,10,0,0"
                                   Text="Stable updates are checked against the official MikereDD/CouchLink GitHub releases."
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="UPDATE CHANNEL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="UpdateChannelDescription"
                                           Margin="0,4,18,0"
                                           Text="Stable releases only."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="UpdateChannelComboBox"
                                      Grid.Column="1"
                                      Width="130"
                                      Style="{StaticResource CouchComboBox}"
                                      SelectedIndex="0"
                                      SelectionChanged="UpdateChannel_SelectionChanged">
                                <ComboBoxItem Content="Stable" />
                                <ComboBoxItem Content="Test" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="UpdateNotesText"
                                   Margin="0,8,0,0"
                                   MaxHeight="110"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="Collapsed" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CheckUpdatesButton"
                                    Style="{StaticResource AccentButton}"
                                    Content="CHECK FOR UPDATES"
                                    Click="CheckUpdates_Click" />
                            <Button x:Name="InstallUpdateButton"
                                    Grid.Column="2"
                                    Style="{StaticResource CouchButton}"
                                    Content="DOWNLOAD AND INSTALL"
                                    Click="InstallUpdate_Click"
                                    IsEnabled="False" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0"
                                   Text="Stable is the default. Test builds are opt-in prereleases. Every channel still requires HTTPS, exact CouchLink asset names, and GitHub SHA-256 verification."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource WindowPanelBrush}"
                        BorderBrush="{StaticResource WindowPanelBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Margin="0,10,0,0"
                                 Height="210"
                                 Padding="12"
                                 Text="{Binding DiagnosticsText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="#343A43" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource CouchButton}"
                    Padding="14,10"
                    Content="COPY DIAGNOSTICS"
                    Click="CopyDiagnostics_Click" />
            <Button Grid.Column="2"
                    Style="{StaticResource CouchButton}"
                    Padding="14,10"
                    Content="CLOSE"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Grid>
</Window>
